
#include "real/resource/resource.hpp"
#include "real/resource/resource_database.hpp"
#include "real/resource/resource_handle.hpp"
#include <gtest/gtest.h>
#include <optional>
#include <vector>

using namespace real;

class TestResource : Resource {
public:
	TestResource()
		: Resource(nullptr, std::nullopt) {}

	~TestResource() {}
};

TEST(Resources, ResourceHandleMemoryLeaks) {
	ResourceDatabase *db = new ResourceDatabase(100);

	ResourceHandle<TestResource> r(db, new TestResource(), ResourceState::Loaded);

	{
		ResourceHandle<TestResource> i(r);
		EXPECT_EQ(i.get_count(), 2);
		i.set_state(ResourceState::NonReferenced);
	}

	EXPECT_EQ(r.get_count(), 1);
	EXPECT_EQ(r.get_state(), ResourceState::NonReferenced);

	delete db;
}

TEST(Resources, ResourceHandleArray) {
	ResourceDatabase *db = new ResourceDatabase(100);

	ResourceHandle<TestResource> r(db, new TestResource(), ResourceState::Loaded);



	delete db;
}

